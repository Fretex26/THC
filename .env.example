# Database configuration (host-side defaults).
# Docker Compose overrides DB_HOST=postgres for the app container.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin
DB_DATABASE=thchallenge
# Use thchallenge for development; e2e uses thchallenge_test via .env.test / .env.docker-test

# Environment. The API listens on process.env.PORT or 3000.
NODE_ENV=production
# Optional. The API listens on process.env.PORT or 3000.
PORT=3000

# Ghibli API configuration
GHIBLI_FILMS_URL=https://ghibliapi.vercel.app/films